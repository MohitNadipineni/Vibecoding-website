import type { Config } from "tailwindcss"

/**
 * TAILWIND v4 CONFIGURATION
 * 
 * NOTE: With Tailwind CSS v4, most theme configuration has moved to CSS.
 * See src/app/globals.css for:
 * - @theme block: Color palette, spacing, border-radius, typography
 * - @layer directives: Custom utilities and component definitions
 * - CSS custom properties: Dynamic theme variables
 * 
 * This config now primarily handles:
 * - Content file paths for template scanning
 * - Plugin registration
 */

const config: Config = {
  darkMode: ["class"],
  content: [
    "./src/app/**/*.{js,ts,jsx,tsx,mdx}",
    "./src/components/**/*.{js,ts,jsx,tsx,mdx}",
    "./pages/**/*.{js,ts,jsx,tsx,mdx}",
    "./src/**/*.{js,ts,jsx,tsx,mdx}",
  ],
  theme: {
    extend: {
      keyframes: {
        "accordion-down": {
          from: { height: "0" },
          to: { height: "var(--radix-accordion-content-height)" },
        },
        "accordion-up": {
          from: { height: "var(--radix-accordion-content-height)" },
          to: { height: "0" },
        },
      },
      animation: {
        "accordion-down": "accordion-down 0.2s ease-out",
        "accordion-up": "accordion-up 0.2s ease-out",
      },
    },
  },
  plugins: [],
}

export default config
